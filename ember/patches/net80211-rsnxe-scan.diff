Origin:
Preserve RSNX information elements in firmware and net80211 scan results.
Mixed WPA2/WPA3 access points supply RSNXE during the four-way handshake;
wpa_supplicant must receive the same element from the scan cache.

--- sys/dev/ic/bwfm.c.orig
+++ sys/dev/ic/bwfm.c
@@ -2346,7 +2346,11 @@
 	scan.sp_rates   = rates;
 	scan.sp_ssid    = ssid;
 
-	for (frm = sfrm; frm < efrm; frm += frm[1] + 2) {
+	for (frm = sfrm; frm + 1 < efrm; frm += frm[1] + 2) {
+		if (frm[1] + 2 > efrm - frm) {
+			ic->ic_stats.is_rx_elem_toosmall++;
+			return;
+		}
 		switch (frm[0]) {
 		case IEEE80211_ELEMID_COUNTRY:
 			scan.sp_country = frm;
@@ -2386,6 +2390,11 @@
 		case IEEE80211_ELEMID_RSN:
 			scan.sp_wpa = frm;
 			break;
+		case IEEE80211_ELEMID_RSNX:
+			if (frm[1] >= 1 && frm[1] <= 16 &&
+			    (frm[2] & 0x0f) + 1 == frm[1])
+				scan.sp_rsnx = frm;
+			break;
 		case IEEE80211_ELEMID_VENDOR:
 			if (frm + 1 >= efrm)
 				break;
