diff --git a/sys/dev/sdmmc/if_bwfm_sdio.c b/sys/dev/sdmmc/if_bwfm_sdio.c
index f330b176e..df9cc03f0 100644
--- a/sys/dev/sdmmc/if_bwfm_sdio.c
+++ b/sys/dev/sdmmc/if_bwfm_sdio.c
@@ -2356,6 +2356,7 @@ bwfm_sdio_sysctl_report(SYSCTLFN_ARGS)
 		timerclear(&sc->sc_report_time);
 		bwfm_sdio_report(sc, "report requested");
