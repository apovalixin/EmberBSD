+    DEBUG ((DEBUG_ERROR, "%a: Failed to patch FRQS. Status=%r\n", __func__, Status));
+    return;
+  }
+
+  Rp1ProgramFan (Rp1Bus);
+  DEBUG ((DEBUG_INFO, "%a: Pi 5 fan exposed through ACPI\n", __func__));
