Origin:

Extend optional CM5 pending-SError tracing to platform initialization,
GPIO and Wi-Fi SDIO register accesses before PCIe initialization.
Record only the first transition to a pending error. Do not clear it.

--- a/Silicon/Broadcom/Bcm27xx/Include/Guid/Cm5PcieTrace.h
+++ b/Silicon/Broadcom/Bcm27xx/Include/Guid/Cm5PcieTrace.h
@@ -8,6 +8,8 @@
 
 #ifdef RP1_UART_CONSOLE
 #include <Library/BaseMemoryLib.h>
+#include <Library/IoLib.h>
+#include <Library/MemoryAllocationLib.h>
 #include <Library/UefiBootServicesTableLib.h>
 
 #define CM5_PCIE_TRACE_GUID \
@@ -81,5 +83,99 @@
   Record->After = After;
   Record->Data = Data;
 }
+
+// Stages 50-56 cover platform entry through HII setup, 60-64 peripheral
+// setup. 200-204 identify the first MMIO operation that sets pending SError.
+STATIC inline VOID
+Cm5PlatformTraceInit (VOID)
+{
+  STATIC EFI_GUID  Guid = CM5_PCIE_TRACE_GUID;
+  CM5_PCIE_TRACE   *Trace;
+  UINT64          Before;
+
+  Before = Cm5PcieReadIsr ();
+  if (Cm5PcieFindTrace () == NULL) {
+    Trace = AllocateZeroPool (sizeof (*Trace));
+    if (Trace != NULL) {
+      Trace->Version = 1;
+      if (EFI_ERROR (gBS->InstallConfigurationTable (&Guid, Trace))) {
+        FreePool (Trace);
+      }
+    }
+  }
+
+  Cm5PcieRecord (50, 0, 0, Before, Cm5PcieReadIsr (), 0);
+}
+
+STATIC inline VOID
+Cm5MmioFirstError (UINT64 Stage, UINTN Address, UINT64 Before, UINT64 Data)
+{
+  UINT64  After;
+
+  After = Cm5PcieReadIsr ();
+  if (((Before & BIT8) == 0) && ((After & BIT8) != 0)) {
+    Cm5PcieRecord (Stage, Address, 0, Before, After, Data);
+  }
+}
+
+STATIC inline UINT32
+Cm5MmioRead32 (UINTN Address)
+{
+  UINT64  Before;
+  UINT32  Data;
+
+  Before = Cm5PcieReadIsr ();
+  Data = MmioRead32 (Address);
+  Cm5MmioFirstError (200, Address, Before, Data);
+  return Data;
+}
+
+STATIC inline UINT32
+Cm5MmioWrite32 (UINTN Address, UINT32 Value)
+{
+  UINT64  Before;
+  UINT32  Data;
+
+  Before = Cm5PcieReadIsr ();
+  Data = MmioWrite32 (Address, Value);
+  Cm5MmioFirstError (201, Address, Before, Data);
+  return Data;
+}
+
+STATIC inline UINT32
+Cm5MmioAnd32 (UINTN Address, UINT32 Value)
+{
+  UINT64  Before;
+  UINT32  Data;
+
+  Before = Cm5PcieReadIsr ();
+  Data = MmioAnd32 (Address, Value);
+  Cm5MmioFirstError (202, Address, Before, Data);
+  return Data;
+}
+
+STATIC inline UINT32
+Cm5MmioOr32 (UINTN Address, UINT32 Value)
+{
+  UINT64  Before;
+  UINT32  Data;
+
+  Before = Cm5PcieReadIsr ();
+  Data = MmioOr32 (Address, Value);
+  Cm5MmioFirstError (203, Address, Before, Data);
+  return Data;
+}
+
+STATIC inline UINT32
+Cm5MmioAndThenOr32 (UINTN Address, UINT32 AndMask, UINT32 OrMask)
+{
+  UINT64  Before;
+  UINT32  Data;
+
+  Before = Cm5PcieReadIsr ();
+  Data = MmioAndThenOr32 (Address, AndMask, OrMask);
+  Cm5MmioFirstError (204, Address, Before, Data);
+  return Data;
+}
 #endif
 #endif
