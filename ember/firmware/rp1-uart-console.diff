+
+// No allocation or boot-service calls: valid while ExitBootServices runs.
+STATIC
+VOID
+ConsoleDiagnosticWrite (
+  IN CONST CHAR8  *Message
+  )
+{
+  UINTN  Timeout;
+
+  if (mDiagnosticUartBase == 0) {
+    return;
+  }
+
+  while (*Message != '\0') {
+    Timeout = 10000;
+    while ((MmioRead32 (mDiagnosticUartBase + 0x18) & BIT5) != 0) {
+      if (--Timeout == 0) {
+        return;
+      }
+    }
+
+    MmioWrite32 (mDiagnosticUartBase, (UINT8)*Message++);
+  }
+}
+
+STATIC
+VOID
+ConsoleDiagnosticIsr (
+  IN CONST CHAR8  *Stage,
+  IN UINT64       Value
