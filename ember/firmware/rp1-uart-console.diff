+STATIC
+UINT64
+DiagnosticReadIsr (
+  VOID
+  )
+{
+  UINT64  Value;
+
+  __asm__ volatile ("dsb sy; isb; mrs %0, isr_el1" : "=r" (Value)
+                    : : "memory");
+  return Value;
