+#ifdef RP1_UART_CONSOLE
+STATIC
+UINT64
+DiagnosticReadIsr (
+  VOID
+  )
+{
+  UINT64  Value;
+
+  __asm__ volatile ("dsb sy; isb; mrs %0, isr_el1" : "=r" (Value)
+                    : : "memory");
+  return Value;
+}
+
+STATIC
+VOID
+Rp1DiagnosticIsr (
+  IN CONST CHAR8  *Stage,
+  IN UINT64       Value
+  )
+{
+  STATIC CONST CHAR8  Digits[] = "0123456789abcdef";
+  STATIC UINT8        Prefix[] = "[CM5 UEFI] ISR ";
+  UINT8               Buffer[96];
+  UINTN               Index;
+  UINTN               Shift;
+
+  SerialPortWrite (Prefix, sizeof (Prefix) - 1);
+  Index = 0;
+  while ((*Stage != '\0') && (Index < sizeof (Buffer) - 20)) {
+    Buffer[Index++] = (UINT8)*Stage++;
+  }
+
+  Buffer[Index++] = '=';
+  for (Shift = 0; Shift < 16; Shift++) {
+    Buffer[Index++] = Digits[(Value >> ((15 - Shift) * 4)) & 15];
+  }
+
+  Buffer[Index++] = '\r';
+  Buffer[Index++] = '\n';
+  SerialPortWrite (Buffer, Index);
+}
+#endif
