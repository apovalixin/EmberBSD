+// Describe the same UART that SerialDxe uses. Its CPU address is assigned
+// by PCI enumeration and differs between boards. This diagnostic SPCR is
+// polled only: RP1's MSI interrupt is not the native UART10 GIC interrupt.
+// The native UART device in the DSDT is left unchanged.
+//
+STATIC
+VOID
+AcpiFixupRp1Console (
+  IN EFI_ACPI_SDT_PROTOCOL  *AcpiSdtProtocol
+  )
+{
+  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE  *Spcr;
+  RP1_BUS_PROTOCOL                               *Rp1Bus;
+  EFI_STATUS                                     Status;
+  UINTN                                          Index;
+  UINTN                                          TableKey;
+  UINT64                                         PeripheralBase;
+
+  Status = gBS->LocateProtocol (&gRp1BusProtocolGuid, NULL, (VOID **)&Rp1Bus);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  PeripheralBase = Rp1Bus->GetPeripheralBase (Rp1Bus);
+  if ((PeripheralBase == 0) || (PeripheralBase > MAX_UINTN - 0x30018)) {
+    return;
+  }
+
+  Index = 0;
+  Status = AcpiLocateTableBySignature (
+             AcpiSdtProtocol,
+             EFI_ACPI_6_3_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_SIGNATURE,
+             &Index,
+             (EFI_ACPI_DESCRIPTION_HEADER **)&Spcr,
+             &TableKey
+             );
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  mDiagnosticUartBase = (UINTN)PeripheralBase + 0x30000;
+  Spcr->BaseAddress.Address = mDiagnosticUartBase;
+  Spcr->InterruptType = 0;
+  Spcr->Irq = 0;
+  Spcr->GlobalSystemInterrupt = 0;
+  AcpiUpdateChecksum ((UINT8 *)Spcr, Spcr->Header.Length);
+  ConsoleDiagnosticWrite ("\r\n[CM5] SPCR uses RP1 UART0 (polled)\r\n");
+}
