+#include <Base.h>
+#include <Uefi.h>
+#include <Protocol/Rp1Bus.h>
+#include <Library/BaseLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+#include <Library/IoLib.h>
+#include <Library/PcdLib.h>
+#include <Library/PL011UartClockLib.h>
+#include <Library/PL011UartLib.h>
+#include <Library/SerialPortLib.h>
+
+// Diagnostic RP1 UART0 on GPIO14/15. UART10 and ACPI remain unchanged.
+#define RP1_UART0_OFFSET  0x30000
+#define RP1_UART_DR       0x00
+#define RP1_UART_FR       0x18
+#define RP1_UART_CR       0x30
+#define RP1_UART_RXFE     BIT4
+#define RP1_UART_TXFF     BIT5
+#define RP1_UART_ENABLE   BIT0
+#define RP1_UART_TXE      BIT8
+#define RP1_UART_RXE      BIT9
+#define RP1_TX_POLL_LIMIT  10000
+
+// Only SerialDxe links this library. Wait until the RP1 PCI driver has
+// enabled the device and published its CPU-visible BAR address.
+STATIC UINTN  mRp1Uart;
+
+STATIC
+UINTN
+Rp1UartBase (
+  VOID
+  )
+{
+  RP1_BUS_PROTOCOL  *Bus;
+  EFI_STATUS        Status;
+  UINTN             Base;
+  UINT32            Control;
+  UINTN             Peripheral;
+  UINTN             Pin;
+  UINTN             Register;
+
+  if (mRp1Uart != 0) {
+    return mRp1Uart;
+  }
+  Status = gBS->LocateProtocol (&gRp1BusProtocolGuid, NULL, (VOID **)&Bus);
+  if (EFI_ERROR (Status)) {
+    return 0;
+  }
+  Base = (UINTN)Bus->GetPeripheralBase (Bus);
+  if ((Base == 0) || (Base > MAX_UINTN - 0xf0040)) {
+    return 0;
+  }
+  Peripheral = Base;
+  Base += RP1_UART0_OFFSET;
+  // Use RP1's 50 MHz reference clock for a known diagnostic baud rate.
+  // The flag is opt-in; no other RP1 UART is used by this firmware.
+  MmioWrite32 (Base + RP1_UART_CR, 0);
+  Control = MmioRead32 (Peripheral + 0x18054);
+  Control &= ~(BIT11 | (0x1fU << 5));
+  Control |= (2U << 5);
+  MmioWrite32 (Peripheral + 0x18054, Control);
+  MmioWrite32 (Peripheral + 0x18058, 1);
+  MmioWrite32 (Peripheral + 0x18054, Control | BIT11);
+  for (Pin = 14; Pin <= 15; Pin++) {
+    Register = Peripheral + 0xd0000 + 4 + Pin * 8;
+    Control = MmioRead32 (Register);
+    Control &= ~(0x1fU | (0x3fU << 12));
+    Control |= 4;
+    MmioWrite32 (Register, Control);
+    Register = Peripheral + 0xf0000 + 4 + Pin * 4;
+    Control = MmioRead32 (Register);
+    Control &= ~(BIT7 | BIT2 | BIT3);
+    Control |= BIT6;
+    if (Pin == 15) {
+      Control |= BIT3;
+    }
+    MmioWrite32 (Register, Control);
+  }
+  // 50 MHz / (16 * (27 + 8/64)) = 115207 baud.
+  MmioWrite32 (Base + 0x24, 27);
+  MmioWrite32 (Base + 0x28, 8);
+  MmioWrite32 (Base + 0x2c, 0x70);
+  MmioWrite32 (Base + 0x38, 0);
+  MmioWrite32 (Base + 0x44, 0x7ff);
+  MmioWrite32 (Base + 0x48, 0);
+  MmioWrite32 (Base + RP1_UART_CR, RP1_UART_ENABLE | RP1_UART_TXE | RP1_UART_RXE);
+  mRp1Uart = Base;
+  return Base;
+}
+
+STATIC
+UINTN
+Rp1UartWrite (
+  IN UINT8  *Buffer,
+  IN UINTN  NumberOfBytes
+  )
+{
+  UINTN  Uart;
+  UINTN  Index;
+  UINTN  Retries;
+
+  Uart = Rp1UartBase ();
+  if (Uart == 0) {
+    return 0;
+  }
+
+  for (Index = 0; Index < NumberOfBytes; Index++) {
+    for (Retries = 0; Retries < RP1_TX_POLL_LIMIT; Retries++) {
+      if ((MmioRead32 (Uart + RP1_UART_FR) & RP1_UART_TXFF) == 0) {
+        break;
+      }
+      CpuPause ();
+    }
+    if (Retries == RP1_TX_POLL_LIMIT) {
+      return Index;
+    }
+    MmioWrite32 (Uart + RP1_UART_DR, Buffer[Index]);
+  }
+  return NumberOfBytes;
+}
+
+/** Initialise the serial device hardware with default settings.
+
+  @retval RETURN_SUCCESS            The serial device was initialised.
+  @retval RETURN_INVALID_PARAMETER  One or more of the default settings
+                                    has an unsupported value.
+ **/
+RETURN_STATUS
+EFIAPI
+SerialPortInitialize (
+  VOID
+  )
+{
+  // SerialDxe may load before the RP1 PCI driver. The first I/O operation
+  // after RP1 publication initializes its GPIO UART.
+  Rp1UartBase ();
+  return EFI_SUCCESS;
+}
+
+/**
+  Write data to serial device.
+
+  @param  Buffer           Point of data buffer which need to be written.
+  @param  NumberOfBytes    Number of output bytes which are cached in Buffer.
+
+  @retval 0                Write data failed.
+  @retval !0               Actual number of bytes written to serial device.
+
+**/
+UINTN
+EFIAPI
+SerialPortWrite (
+  IN UINT8  *Buffer,
+  IN UINTN  NumberOfBytes
+  )
+{
+  return Rp1UartWrite (Buffer, NumberOfBytes);
+}
+
+/**
+  Read data from serial device and save the data in buffer.
+
+  @param  Buffer           Point of data buffer which need to be written.
+  @param  NumberOfBytes    Number of output bytes which are cached in Buffer.
+
+  @retval 0                Read data failed.
+  @retval !0               Actual number of bytes read from serial device.
+
+**/
+UINTN
+EFIAPI
+SerialPortRead (
+  OUT UINT8  *Buffer,
+  IN  UINTN  NumberOfBytes
+  )
+{
+  UINTN  Uart;
+  UINTN  Count;
+
+  Uart = Rp1UartBase ();
+  Count = 0;
+  if (Uart != 0) {
+    while ((Count < NumberOfBytes) &&
+           ((MmioRead32 (Uart + RP1_UART_FR) & RP1_UART_RXFE) == 0)) {
+      Buffer[Count++] = (UINT8)MmioRead32 (Uart + RP1_UART_DR);
+    }
+  }
+  if (Count != 0) {
+    return Count;
+  }
+  return 0;
+}
+
+/**
+  Check to see if any data is available to be read from the debug device.
+
+  @retval TRUE       At least one byte of data is available to be read
+  @retval FALSE      No data is available to be read
+
+**/
+BOOLEAN
+EFIAPI
+SerialPortPoll (
+  VOID
+  )
+{
+  UINTN  Uart;
+
+  Uart = Rp1UartBase ();
+  return (Uart != 0) && ((MmioRead32 (Uart + RP1_UART_FR) & RP1_UART_RXFE) == 0);
+}
+
+/**
+  Set new attributes to PL011.
+
+  @param  BaudRate                The baud rate of the serial device. If the
+                                  baud rate is not supported, the speed will
+                                  be reduced down to the nearest supported one
+                                  and the variable's value will be updated
+                                  accordingly.
+  @param  ReceiveFifoDepth        The number of characters the device will
+                                  buffer on input. If the specified value is
+                                  not supported, the variable's value will
+                                  be reduced down to the nearest supported one.
+  @param  Timeout                 If applicable, the number of microseconds the
+                                  device will wait before timing out a Read or
+                                  a Write operation.
+  @param  Parity                  If applicable, this is the EFI_PARITY_TYPE
+                                  that is computed or checked as each character
+                                  is transmitted or received. If the device
+                                  does not support parity, the value is the
+                                  default parity value.
+  @param  DataBits                The number of data bits in each character
+  @param  StopBits                If applicable, the EFI_STOP_BITS_TYPE number
+                                  of stop bits per character. If the device
+                                  does not support stop bits, the value is the
+                                  default stop bit value.
+
+  @retval EFI_SUCCESS             All attributes were set correctly.
+  @retval EFI_INVALID_PARAMETERS  One or more attributes has an unsupported
+                                  value.
+
+**/
+RETURN_STATUS
+EFIAPI
+SerialPortSetAttributes (
+  IN OUT UINT64              *BaudRate,
+  IN OUT UINT32              *ReceiveFifoDepth,
+  IN OUT UINT32              *Timeout,
+  IN OUT EFI_PARITY_TYPE     *Parity,
+  IN OUT UINT8               *DataBits,
+  IN OUT EFI_STOP_BITS_TYPE  *StopBits
+  )
+{
+  if ((*BaudRate != 0 && *BaudRate != 115200) ||
+      (*DataBits != 0 && *DataBits != 8) ||
+      (*Parity != DefaultParity && *Parity != NoParity) ||
+      (*StopBits != DefaultStopBits && *StopBits != OneStopBit)) {
+    return EFI_UNSUPPORTED;
+  }
+  *BaudRate = 115200;
+  *ReceiveFifoDepth = 16;
+  *DataBits = 8;
+  *Parity = NoParity;
+  *StopBits = OneStopBit;
+  return EFI_SUCCESS;
+}
+
+/**
+
+  Assert or deassert the control signals on a serial port.
+  The following control signals are set according their bit settings :
+  . Request to Send
+  . Data Terminal Ready
+
+  @param[in]  Control  The following bits are taken into account :
+                       . EFI_SERIAL_REQUEST_TO_SEND : assert/deassert the
+                         "Request To Send" control signal if this bit is
+                         equal to one/zero.
+                       . EFI_SERIAL_DATA_TERMINAL_READY : assert/deassert
+                         the "Data Terminal Ready" control signal if this
+                         bit is equal to one/zero.
+                       . EFI_SERIAL_HARDWARE_LOOPBACK_ENABLE : enable/disable
+                         the hardware loopback if this bit is equal to
+                         one/zero.
+                       . EFI_SERIAL_SOFTWARE_LOOPBACK_ENABLE : not supported.
+                       . EFI_SERIAL_HARDWARE_FLOW_CONTROL_ENABLE : enable/
+                         disable the hardware flow control based on CTS (Clear
+                         To Send) and RTS (Ready To Send) control signals.
+
+  @retval  RETURN_SUCCESS      The new control bits were set on the device.
+  @retval  RETURN_UNSUPPORTED  The device does not support this operation.
+
+**/
+RETURN_STATUS
+EFIAPI
+SerialPortSetControl (
+  IN UINT32  Control
+  )
+{
+  if ((Control & (EFI_SERIAL_HARDWARE_FLOW_CONTROL_ENABLE |
+                  EFI_SERIAL_HARDWARE_LOOPBACK_ENABLE |
+                  EFI_SERIAL_SOFTWARE_LOOPBACK_ENABLE)) != 0) {
+    return EFI_UNSUPPORTED;
+  }
+  return EFI_SUCCESS;
+}
+
+/**
+
+  Retrieve the status of the control bits on a serial device.
+
+  @param[out]  Control  Status of the control bits on a serial device :
+
+                        . EFI_SERIAL_DATA_CLEAR_TO_SEND,
+                          EFI_SERIAL_DATA_SET_READY,
+                          EFI_SERIAL_RING_INDICATE,
+                          EFI_SERIAL_CARRIER_DETECT,
+                          EFI_SERIAL_REQUEST_TO_SEND,
+                          EFI_SERIAL_DATA_TERMINAL_READY
+                          are all related to the DTE (Data Terminal Equipment)
+                          and DCE (Data Communication Equipment) modes of
+                          operation of the serial device.
+                        . EFI_SERIAL_INPUT_BUFFER_EMPTY : equal to one if the
+                          receive buffer is empty, 0 otherwise.
+                        . EFI_SERIAL_OUTPUT_BUFFER_EMPTY : equal to one if the
+                          transmit buffer is empty, 0 otherwise.
+                        . EFI_SERIAL_HARDWARE_LOOPBACK_ENABLE : equal to one if
+                          the hardware loopback is enabled (the output feeds
+                          the receive buffer), 0 otherwise.
+                        . EFI_SERIAL_SOFTWARE_LOOPBACK_ENABLE : equal to one
+                          if a loopback is accomplished by software, else 0.
+                        . EFI_SERIAL_HARDWARE_FLOW_CONTROL_ENABLE : equal to
+                          one if the hardware flow control based on CTS (Clear
+                          To Send) and RTS (Ready To Send) control signals is
+                          enabled, 0 otherwise.
+
+  @retval RETURN_SUCCESS  The control bits were read from the device.
+
+**/
+RETURN_STATUS
+EFIAPI
+SerialPortGetControl (
+  OUT UINT32  *Control
+  )
+{
+  UINTN  Uart;
+
+  Uart = Rp1UartBase ();
+  *Control = EFI_SERIAL_INPUT_BUFFER_EMPTY | EFI_SERIAL_OUTPUT_BUFFER_EMPTY;
+  if (Uart != 0) {
+    if ((MmioRead32 (Uart + RP1_UART_FR) & RP1_UART_RXFE) == 0) {
+      *Control &= ~EFI_SERIAL_INPUT_BUFFER_EMPTY;
+    }
+    if ((MmioRead32 (Uart + RP1_UART_FR) & BIT3) != 0) {
+      *Control &= ~EFI_SERIAL_OUTPUT_BUFFER_EMPTY;
+    }
+  }
+  return EFI_SUCCESS;
+}
