+/*
+ * A Cadence GEM, the controller behind the Raspberry Pi 5's Ethernet
+ * (it sits in RP1), so that a driver for that port can be run before
+ * it meets the board. Made only when a -nic names model=cadence_gem:
+ * without one the machine is exactly the stock virt. The PHY answers
+ * at MDIO address 1, where the Pi 5's BCM54213PE sits. ACPI only, as
+ * on the Pi 5: no device tree node is written.
+ */
+static void create_gem(VirtMachineState *vms)
+{
+    NICInfo *nd = qemu_find_nic_info(TYPE_CADENCE_GEM, false, NULL);
+    DeviceState *dev;
+    SysBusDevice *s;
+
+    if (!nd) {
+        return;
+    }
+    dev = qdev_new(TYPE_CADENCE_GEM);
+    qdev_set_nic_properties(dev, nd);
+    qdev_prop_set_uint8(dev, "phy-addr", 1);
+    s = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(s, &error_fatal);
+    sysbus_mmio_map(s, 0, vms->memmap[VIRT_GEM].base);
+    sysbus_connect_irq(s, 0,
+                       qdev_get_gpio_in(vms->gic, vms->irqmap[VIRT_GEM]));
+    vms->gem = dev;
+}
+
 static void create_rtc(const VirtMachineState *vms)
 {
     char *nodename;
@@ -3208,6 +3239,9 @@ static void machvirt_init(MachineState *machine)
 
     create_rtc(vms);
 
+    /* Before the PCIe NICs: they would take its -nic as theirs. */
+    create_gem(vms);
+
     create_pcie(vms);
     create_cxl_host_reg_region(vms);
 
