Origin: against QEMU v11.1.1.
A Cadence GEM in the virt machine, described in ACPI the way the
Raspberry Pi 5's UEFI describes RP1's Ethernet, so that our driver for
that port runs on the Mac before it meets the board. Applied by
`nbk qemu` with `git apply`.

diff --git a/hw/arm/virt-acpi-build.c b/hw/arm/virt-acpi-build.c
index f638608..6ee40b9 100644
--- a/hw/arm/virt-acpi-build.c
+++ b/hw/arm/virt-acpi-build.c
@@ -105,6 +105,43 @@ static void acpi_dsdt_add_uart(Aml *scope, const MemMapEntry *uart_memmap,
     aml_append(scope, dev);
 }
 
+/*
+ * The GEM as the Raspberry Pi 5's UEFI describes RP1's Ethernet
+ * (eotics-com/rpi5-uefi, Rp1.asi): PRP0001 with compatible "cdns,macb",
+ * one QWordMemory window and a level, active-high, shared interrupt.
+ * One difference: QEMU's helper marks the window a producer where the
+ * Pi 5's table says consumer; NetBSD reads neither bit.
+ */
+static void acpi_dsdt_add_gem(Aml *scope, const MemMapEntry *gem_memmap,
+                              uint32_t gem_irq)
+{
+    Aml *dev = aml_device("ETH0");
+    aml_append(dev, aml_name_decl("_HID", aml_string("PRP0001")));
+    aml_append(dev, aml_name_decl("_UID", aml_int(0)));
+
+    Aml *crs = aml_resource_template();
+    aml_append(crs, aml_qword_memory(AML_POS_DECODE, AML_MIN_FIXED,
+                                     AML_MAX_FIXED, AML_NON_CACHEABLE,
+                                     AML_READ_WRITE, 0, gem_memmap->base,
+                                     gem_memmap->base + gem_memmap->size - 1,
+                                     0, gem_memmap->size));
+    aml_append(crs, aml_interrupt(AML_CONSUMER, AML_LEVEL, AML_ACTIVE_HIGH,
+                                  AML_SHARED, &gem_irq, 1));
+    aml_append(dev, aml_name_decl("_CRS", crs));
+
+    Aml *compatible = aml_package(2);
+    aml_append(compatible, aml_string("compatible"));
+    aml_append(compatible, aml_string("cdns,macb"));
+    Aml *properties = aml_package(1);
+    aml_append(properties, compatible);
+    Aml *dsd = aml_package(2);
+    aml_append(dsd, aml_touuid("DAFFD814-6EBA-4D8C-8A91-BC9BBF4AA301"));
+    aml_append(dsd, properties);
+    aml_append(dev, aml_name_decl("_DSD", dsd));
+
+    aml_append(scope, dev);
+}
+
