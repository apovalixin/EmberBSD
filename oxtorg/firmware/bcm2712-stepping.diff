Origin:
One build for the BCM2712 C0/C1 and D0. The rpi5-20260730.1 release
(eotics c4b5d05) is built for D0 (8d71efb3d5 "Set pinctrl lengths for
D0", aa8151c68c "Adjust UART interrupt for D0"). On a C1 its pin layout
muxes the Wi-Fi SDIO pins wrong and the console UART gets the wrong
interrupt.
The stepping comes from the boot loader's device tree. On a D0 it hands
over bcm2712d0-rpi-5-b.dtb or applies overlays/bcm2712d0.dtbo, and both
name "brcm,bcm2712d0-pinctrl"; a C0/C1 tree names "brcm,bcm2712-pinctrl".
Only the latter selects C1: a tree without the node keeps the release's
D0 behaviour. Raspberry Pi's bcm2712d0-overlay.dts lists what differs;
two of those items are the firmware's:
- the pin controller layout. The GPIO library gets the C0/C1 tables it
  had before 8d71efb3d5 next to the D0 ones, and GpioInitialize ()
  picks one. The C0/C1 function numbers of the seven pins
  InitGpioPinctrls sets are those of Linux's pinctrl-bcm2712.c;
- the debug UART's interrupt, GIC SPI 121 on C0/C1 and 120 on D0. SPCR
  and \_SB.SOCB.URT0.URTI get the C0/C1 number at install time.
The selection by the FDT compatible and GpioInitialize (IsD0) follow
damian5466/edk2-platforms (766b18949a) and farjanatech/rpi5-uefi
(temporary-patches/0004); neither moves the UART interrupt. eotics' later
code reads a stepping register instead (BCM2712_SOC_STEPPING_BASE,
0x1001504004, rpi5 e547cd467f). On our C1 boards a read of it from
NetBSD user space through /dev/mem ends in a bus error, as do the chip
ID registers at 0x107d504000; the pin controller next to them reads
fine. This diff does not use them.
Replaces the reverts of 8d71efb3d5 and aa8151c68c (NumberOneGit
a55431926d and 3f12136f81). Tested on C1 boards only.

diff --git a/Platform/RaspberryPi/RPi5/AcpiTables/Dsdt.asl b/Platform/RaspberryPi/RPi5/AcpiTables/Dsdt.asl
index 24893bd..3536c40 100644
--- a/Platform/RaspberryPi/RPi5/AcpiTables/Dsdt.asl
+++ b/Platform/RaspberryPi/RPi5/AcpiTables/Dsdt.asl
@@ -92,12 +92,18 @@ DefinitionBlock ("Dsdt.aml", "DSDT", 2, "RPIFDN", "RPI5    ", 2)
         Name (_UID, 0x0)
         Name (_CCA, 0x0)
 
+        // The interrupt differs between steppings; the platform driver
+        // patches in the C0/C1 number over the D0 one.
+        Name (URTI, PL011_DEBUG_INTERRUPT)
+
         Method (_CRS, 0x0, Serialized) {
           Name (RBUF, ResourceTemplate () {
             QWORDMEMORY_BUF (00, ResourceConsumer)
-            Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { PL011_DEBUG_INTERRUPT }
+            Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive, , , UIRQ) { PL011_DEBUG_INTERRUPT }
           })
           QWORD_SET (00, PL011_DEBUG_BASE_ADDRESS, PL011_DEBUG_LENGTH, 0)
+          CreateDWordField (RBUF, UIRQ._INT, IRQN)
+          IRQN = URTI
           Return (RBUF)
         }
 
diff --git a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/ConfigTable.c b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/ConfigTable.c
index 1a8cb98..c1b4e03 100644
--- a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/ConfigTable.c
+++ b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/ConfigTable.c
@@ -10,6 +10,7 @@
 #include <IndustryStandard/Acpi.h>
 #include <IndustryStandard/Pci.h>
 #include <IndustryStandard/PeImage.h>
+#include <IndustryStandard/SerialPortConsoleRedirectionTable.h>
 #include <Library/AcpiLib.h>
 #include <Library/BaseLib.h>
 #include <Library/BaseMemoryLib.h>
@@ -455,6 +456,54 @@ DsdtFixupPcie (
   }
 }
 
+//
+// The debug UART (PL011) interrupts on GIC SPI 120 on a D0 and SPI 121 on
+// a C0/C1 (Raspberry Pi Linux, overlays/bcm2712d0-overlay.dts). SPCR and
+// the DSDT are built with the D0 number.
+//
+#define PL011_DEBUG_INTERRUPT_C1  153
+
+STATIC
+VOID
+EFIAPI
+AcpiFixupDebugUartInterrupt (
+  IN EFI_ACPI_SDT_PROTOCOL    *AcpiSdtProtocol,
+  IN EFI_ACPI_HANDLE          TableHandle
+  )
+{
+  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE  *Spcr;
+  EFI_STATUS                                      Status;
+  UINTN                                           Index;
+  UINTN                                           TableKey;
+
+  if (Bcm2712IsD0 ()) {
+    return;
+  }
+
+  Status = AcpiAmlObjectUpdateInteger (AcpiSdtProtocol, TableHandle,
+              "\\_SB.SOCB.URT0.URTI", PL011_DEBUG_INTERRUPT_C1);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: Failed to patch \\_SB.SOCB.URT0.URTI. Status=%r\n",
+            __func__, Status));
+  }
+
+  Index = 0;
+  Status = AcpiLocateTableBySignature (
+             AcpiSdtProtocol,
+             EFI_ACPI_6_3_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_SIGNATURE,
+             &Index,
+             (EFI_ACPI_DESCRIPTION_HEADER **)&Spcr,
+             &TableKey);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: Couldn't locate ACPI SPCR table! Status=%r\n",
+            __func__, Status));
+    return;
+  }
+
+  Spcr->GlobalSystemInterrupt = PL011_DEBUG_INTERRUPT_C1;
+  AcpiUpdateChecksum ((UINT8 *)Spcr, Spcr->Header.Length);
+}
+
 STATIC
 EFI_STATUS
 EFIAPI
@@ -974,6 +1023,7 @@ InstallAcpiTables (
   DsdtFixupSd (mAcpiSdtProtocol, TableHandle);
   DsdtFixupRp1 (mAcpiSdtProtocol, TableHandle);
   DsdtFixupPcie (mAcpiSdtProtocol, TableHandle);
+  AcpiFixupDebugUartInterrupt (mAcpiSdtProtocol, TableHandle);
 
   mAcpiSdtProtocol->Close (TableHandle);
 
