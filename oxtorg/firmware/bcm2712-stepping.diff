 #include <Library/IoLib.h>
 #include <Library/UefiBootServicesTableLib.h>
 #include <Library/UefiRuntimeServicesTableLib.h>
@@ -62,6 +64,48 @@ RegisterSdControllers (
   return Status;
 }
 
+//
+// The BCM2712 C0/C1 and D0 lay out their pin controllers differently, and
+// D0 moves the debug UART's interrupt (Raspberry Pi Linux,
+// overlays/bcm2712d0-overlay.dts). The boot loader knows the stepping: on
+// a D0 it hands over bcm2712d0-rpi-5-b.dtb or applies that overlay, and
+// both name the D0 pin controller. Only a device tree that names the
+// C0/C1 controller selects C1; otherwise the D0 layout stays.
+//
+BOOLEAN
+EFIAPI
+Bcm2712IsD0 (
+  VOID
+  )
+{
+  STATIC BOOLEAN  Known;
+  STATIC BOOLEAN  IsD0;
+  VOID            *Fdt;
+
+  if (!Known) {
+    Fdt   = FdtPlatformGetBase ();
+    IsD0  = (Fdt == NULL) ||
+            (FdtNodeOffsetByCompatible (Fdt, -1, "brcm,bcm2712-pinctrl") < 0);
+    Known = TRUE;
+    DEBUG ((DEBUG_INFO, "BCM2712: %a pin controller layout\n", IsD0 ? "D0" : "C0/C1"));
+  }
+
+  return IsD0;
+}
+
+//
+// C0/C1 function numbers of the pins set below. Bcm2712Pinctrl.h describes
+// D0; these are the numbers of its layout before 8d71efb3d5, the same as
+// Raspberry Pi Linux's bcm2712_c0 function tables.
+//
+#define C1_GIO_AON_PIN5_ALT_SD_CARD_G  6
+#define C1_GIO_PIN30_ALT_SD2           4
+#define C1_GIO_PIN31_ALT_SD2           4
+#define C1_GIO_PIN32_ALT_SD2           4
+#define C1_GIO_PIN33_ALT_SD2           3
+#define C1_GIO_PIN34_ALT_SD2           4
+#define C1_GIO_PIN35_ALT_SD2           3
+
 STATIC
 EFI_STATUS
 EFIAPI
@@ -69,8 +113,14 @@ InitGpioPinctrls (
   VOID
   )
 {
+  BOOLEAN  IsD0;
+
+  IsD0 = Bcm2712IsD0 ();
+  GpioInitialize (IsD0);
+
   // SD card detect
-  GpioSetFunction (BCM2712_GIO_AON, 5, GIO_AON_PIN5_ALT_SD_CARD_G);
+  GpioSetFunction (BCM2712_GIO_AON, 5,
+    IsD0 ? GIO_AON_PIN5_ALT_SD_CARD_G : C1_GIO_AON_PIN5_ALT_SD_CARD_G);
   GpioSetPull (BCM2712_GIO_AON, 5, BCM2712_GPIO_PIN_PULL_UP);
 
   // The slot stays powered: UEFI boots from the card. ACPI's power
@@ -83,17 +133,17 @@ InitGpioPinctrls (
   GpioSetDirection (BCM2712_GIO_AON, 3, BCM2712_GPIO_PIN_OUTPUT);
 
   // Route SDIO to Wi-Fi
-  GpioSetFunction (BCM2712_GIO, 30, GIO_PIN30_ALT_SD2);
+  GpioSetFunction (BCM2712_GIO, 30, IsD0 ? GIO_PIN30_ALT_SD2 : C1_GIO_PIN30_ALT_SD2);
   GpioSetPull (BCM2712_GIO, 30, BCM2712_GPIO_PIN_PULL_NONE);
-  GpioSetFunction (BCM2712_GIO, 31, GIO_PIN31_ALT_SD2);
+  GpioSetFunction (BCM2712_GIO, 31, IsD0 ? GIO_PIN31_ALT_SD2 : C1_GIO_PIN31_ALT_SD2);
   GpioSetPull (BCM2712_GIO, 31, BCM2712_GPIO_PIN_PULL_UP);
-  GpioSetFunction (BCM2712_GIO, 32, GIO_PIN32_ALT_SD2);
+  GpioSetFunction (BCM2712_GIO, 32, IsD0 ? GIO_PIN32_ALT_SD2 : C1_GIO_PIN32_ALT_SD2);
   GpioSetPull (BCM2712_GIO, 32, BCM2712_GPIO_PIN_PULL_UP);
-  GpioSetFunction (BCM2712_GIO, 33, GIO_PIN33_ALT_SD2);
+  GpioSetFunction (BCM2712_GIO, 33, IsD0 ? GIO_PIN33_ALT_SD2 : C1_GIO_PIN33_ALT_SD2);
   GpioSetPull (BCM2712_GIO, 33, BCM2712_GPIO_PIN_PULL_UP);
-  GpioSetFunction (BCM2712_GIO, 34, GIO_PIN34_ALT_SD2);
+  GpioSetFunction (BCM2712_GIO, 34, IsD0 ? GIO_PIN34_ALT_SD2 : C1_GIO_PIN34_ALT_SD2);
   GpioSetPull (BCM2712_GIO, 34, BCM2712_GPIO_PIN_PULL_UP);
-  GpioSetFunction (BCM2712_GIO, 35, GIO_PIN35_ALT_SD2);
+  GpioSetFunction (BCM2712_GIO, 35, IsD0 ? GIO_PIN35_ALT_SD2 : C1_GIO_PIN35_ALT_SD2);
   GpioSetPull (BCM2712_GIO, 35, BCM2712_GPIO_PIN_PULL_UP);
 
   // CYW43455 WL_ON
