+#ifdef RP1_UART_CONSOLE
+STATIC BOOLEAN  mCm5FirstConfigAccess = TRUE;
+
+STATIC
+VOID
+PciTraceFirstError (
+  UINT64 Stage, UINT64 Address, UINT64 Base,
+  UINT64 Before, UINT64 After, UINT64 Data
+  )
+{
+  if (mCm5FirstConfigAccess && (Cm5PcieFindTrace () != NULL)) {
+    Cm5PcieRecord (90, Address, Base, Before, After, Data);
+    mCm5FirstConfigAccess = FALSE;
+  }
+
+  if (((Before & BIT8) == 0) && ((After & BIT8) != 0)) {
+    Cm5PcieRecord (Stage, Address, Base, Before, After, Data);
+  }
+}
+#endif
