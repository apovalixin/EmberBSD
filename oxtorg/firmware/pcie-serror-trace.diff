Origin:

Optional PCIe SError tracing with RP1_UART_CONSOLE. Store initialization
stages and the first PCI configuration access which changes ISR_EL1
in boot-service memory; print them after the GPIO console becomes ready.
No pending error is masked or cleared. The default build has no probes.

--- a/Silicon/Broadcom/Bcm27xx/Include/Guid/Cm5PcieTrace.h
+++ b/Silicon/Broadcom/Bcm27xx/Include/Guid/Cm5PcieTrace.h
@@ -0,0 +1,85 @@
+/** @file
+  Optional CM5 PCIe SError trace. No error state is acknowledged or cleared.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#ifndef CM5_PCIE_TRACE_H
+#define CM5_PCIE_TRACE_H
+
+#ifdef RP1_UART_CONSOLE
+#include <Library/BaseMemoryLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+#define CM5_PCIE_TRACE_GUID \
+  { 0x8fe2a74d, 0x2196, 0x4a6e, { 0xb4, 0x41, 0xea, 0x93, 0x23, 0xe8, 0x3b, 0x0c } }
+#define CM5_PCIE_TRACE_CAPACITY  64
+
+// Stages: 1 entry, 2 reset, 3 PHY, 4 MISC_CTRL, 5 UBUS error policy,
+// 6 timeouts/QoS, 7 inbound, 8 outbound, 9 interrupts/class/endian,
+// 10 speed/ASPM, 11 deassert reset, 12 link wait.
+// 90 first PCI config access; 100 index, 101 read, 102 write first SError.
+typedef struct {
+  UINT64  Stage;
+  UINT64  Address;
+  UINT64  Auxiliary;
+  UINT64  Before;
+  UINT64  After;
+  UINT64  Data;
+} CM5_PCIE_TRACE_RECORD;
+
+typedef struct {
+  UINT32                 Version;
+  UINT32                 Count;
+  CM5_PCIE_TRACE_RECORD  Records[CM5_PCIE_TRACE_CAPACITY];
+} CM5_PCIE_TRACE;
+
+STATIC inline UINT64
+Cm5PcieReadIsr (VOID)
+{
+  UINT64  Value;
+
+  __asm__ volatile ("dsb sy; isb; mrs %0, isr_el1" : "=r" (Value)
+                    : : "memory");
+  return Value;
+}
+
+STATIC inline CM5_PCIE_TRACE *
+Cm5PcieFindTrace (VOID)
+{
+  STATIC EFI_GUID  Guid = CM5_PCIE_TRACE_GUID;
+  UINTN            Index;
+
+  for (Index = 0; Index < gST->NumberOfTableEntries; Index++) {
+    if (CompareGuid (&gST->ConfigurationTable[Index].VendorGuid, &Guid)) {
+      return gST->ConfigurationTable[Index].VendorTable;
+    }
+  }
+
+  return NULL;
+}
+
+STATIC inline VOID
+Cm5PcieRecord (
+  UINT64 Stage, UINT64 Address, UINT64 Auxiliary,
+  UINT64 Before, UINT64 After, UINT64 Data
+  )
+{
+  CM5_PCIE_TRACE         *Trace;
+  CM5_PCIE_TRACE_RECORD  *Record;
+
+  Trace = Cm5PcieFindTrace ();
+  if ((Trace == NULL) || (Trace->Version != 1) ||
+      (Trace->Count >= CM5_PCIE_TRACE_CAPACITY)) {
+    return;
+  }
+
+  Record = &Trace->Records[Trace->Count++];
+  Record->Stage = Stage;
+  Record->Address = Address;
+  Record->Auxiliary = Auxiliary;
+  Record->Before = Before;
+  Record->After = After;
+  Record->Data = Data;
+}
+#endif
+#endif
