+  SdhciDiagnosticHex ("[CM5 SDHCI] present=", MmioRead32 (Device->HostAddress + 0x24));
+  SdhciDiagnosticHex ("[CM5 SDHCI] clock=", MmioRead32 (Device->HostAddress + 0x2c));
+#endif
+
   switch (PhaseType) {
     case EdkiiSdMmcSetSignalingVoltage:
       if (PhaseData == NULL) {
@@ -133,6 +173,13 @@
                      ~SDIO_CFG_CTRL_SDCD_N_TEST_LEV,
                      SDIO_CFG_CTRL_SDCD_N_TEST_EN);
   }
+
+#ifdef RP1_UART_CONSOLE
+  SdhciDiagnosticHex ("[CM5 SDHCI] host=", This->HostAddress);
+  SdhciDiagnosticHex ("[CM5 SDHCI] removable=", This->IsSlotRemovable);
+  SdhciDiagnosticHex ("[CM5 SDHCI] config=", MmioRead32 (This->CfgAddress));
+  SdhciDiagnosticHex ("[CM5 SDHCI] pin select=", MmioRead32 (This->CfgAddress + 0x44));
