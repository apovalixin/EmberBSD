Origin:

Optional RP1 console diagnostics for SDHCI capabilities, host phases
and boot-device discovery. Read status registers without changing them.
The default build has no new output or console routing.

--- a/Silicon/Broadcom/Drivers/BrcmStbSdhciDxe/BrcmStbSdhciDxe.c
+++ b/Silicon/Broadcom/Drivers/BrcmStbSdhciDxe/BrcmStbSdhciDxe.c
@@ -17,6 +17,31 @@
 #include <Protocol/SdMmcOverride.h>
 
 #include "BrcmStbSdhciDxe.h"
+#ifdef RP1_UART_CONSOLE
+#include <Library/SerialPortLib.h>
+#include <Library/BaseMemoryLib.h>
+#endif
+
+#ifdef RP1_UART_CONSOLE
+STATIC
+VOID
+SdhciDiagnosticHex (CONST CHAR8 *Label, UINT64 Value)
+{
+  STATIC CONST CHAR8  Digits[] = "0123456789abcdef";
+  CHAR8               Buffer[19];
+  UINTN               Index;
+
+  for (Index = 0; Index < 16; Index++) {
+    Buffer[Index] = Digits[(Value >> ((15 - Index) * 4)) & 15];
+  }
+
+  Buffer[16] = '\r';
+  Buffer[17] = '\n';
+  Buffer[18] = '\0';
+  SerialPortWrite ((UINT8 *)Label, AsciiStrLen (Label));
+  SerialPortWrite ((UINT8 *)Buffer, 18);
+}
+#endif
 
 STATIC
 EFI_STATUS
@@ -51,6 +76,15 @@
   Capability->Sdr50  = 0;
   Capability->Sdr104 = 0;
   Capability->Ddr50  = 0;
+#ifdef RP1_UART_CONSOLE
+  {
+    UINT64  RawCapability;
+
+    CopyMem (&RawCapability, Capability, sizeof (RawCapability));
+    SdhciDiagnosticHex ("[CM5 SDHCI] capabilities=", RawCapability);
+    SdhciDiagnosticHex ("[CM5 SDHCI] base MHz=", *BaseClkFreq);
+  }
+#endif
 
   return EFI_SUCCESS;
 }
@@ -82,6 +116,12 @@
     return EFI_UNSUPPORTED;
   }
 
+#ifdef RP1_UART_CONSOLE
