Origin:
Make the on-board Wi-Fi's SDIO host usable on the BCM2712 C1.
InitWifiSdioHost sets the SDIO2 50 MHz strap override with ENABLE clear.
On our C1 boards the host is then unusable: SD bus power does not stay
on, and NetBSD's sdmmc gives up on the slot. Linux sets that override
only for modes that need tuning, which this slot does not offer; here
it is cleared instead, on either stepping. With it clear before the
host's first reset the CYW43455 answers and runs 4-bit at 50 MHz under
NetBSD.
The same function writes a raw D0 pin table. InitGpioPinctrls already
muxes the SDIO2 pins 30-35 in the layout of the running stepping
(bcm2712-stepping.diff): on a D0 the table repeats that, on a C1 it
lands on GPIO 22-27 (the Bluetooth UART among them) and the mux of
46-49. The table goes.
farjanatech/rpi5-uefi independently dropped the same strap override
for Windows (temporary-patches/0004).

diff --git a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/Peripherals.c b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/Peripherals.c
index 325868d..e3df098 100644
--- a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/Peripherals.c
+++ b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/Peripherals.c
@@ -176,29 +176,12 @@ InitWifiSdioHost (
   VOID
   )
 {
-  STATIC CONST UINT32 Sdio2D0Pins[6][6] = {
-    { 0x08, 24, 1, 0x14, 24, 0 },
-    { 0x08, 28, 1, 0x14, 26, 2 },
-    { 0x0C, 0,  1, 0x14, 28, 2 },
-    { 0x0C, 4,  1, 0x18, 0,  2 },
-    { 0x0C, 8,  1, 0x18, 2,  2 },
-    { 0x0C, 12, 1, 0x18, 4,  2 }
-  };
-  UINTN   Index;
   UINT32  Reg;
 
-  // SDIO2 D0 pinctrl
-  for (Index = 0; Index < 6; Index++) {
-    Reg = MmioRead32 (BCM2712_PINCTRL_BASE + Sdio2D0Pins[Index][0]);
-    Reg &= ~(0xFU << Sdio2D0Pins[Index][1]);
-    Reg |= (Sdio2D0Pins[Index][2] & 0xF) << Sdio2D0Pins[Index][1];
-    MmioWrite32 (BCM2712_PINCTRL_BASE + Sdio2D0Pins[Index][0], Reg);
-
-    Reg = MmioRead32 (BCM2712_PINCTRL_BASE + Sdio2D0Pins[Index][3]);
-    Reg &= ~(0x3U << Sdio2D0Pins[Index][4]);
-    Reg |= (Sdio2D0Pins[Index][5] & 0x3) << Sdio2D0Pins[Index][4];
-    MmioWrite32 (BCM2712_PINCTRL_BASE + Sdio2D0Pins[Index][3], Reg);
-  }
+  // The SDIO2 pins are muxed by InitGpioPinctrls, in the layout of the
+  // running stepping. The release's raw D0 pin table is not written: on
+  // a C1 it lands on GPIO 22-27 (the Bluetooth UART among them) and the
+  // mux of 46-49.
 
   // SD/MMC pin-select -> SD
   Reg = MmioRead32 (BCM2712_BRCMSTB_SDIO2_CFG_BASE + SDIO2_CFG_SD_PIN_SEL);
@@ -209,10 +192,14 @@ InitWifiSdioHost (
   // Wait for WL_ON to settle.
   gBS->Stall (150000);
 
-  // 50 MHz strap override
+  // No 50 MHz strap override. Override with ENABLE clear selects the
+  // delay-line PHY as the host's clock source; Linux does that only
+  // for modes that need tuning (SDR50 and faster), and this slot
+  // offers DDR50 at most. On a C1 with the override set the host is
+  // unusable: SD bus power does not stay on. Clear any override left
+  // by an earlier stage.
   Reg = MmioRead32 (BCM2712_BRCMSTB_SDIO2_CFG_BASE + SDIO2_CFG_MAX_50MHZ_MODE);
-  Reg &= ~SDIO2_CFG_MAX_50MHZ_MODE_ENABLE;
-  Reg |= SDIO2_CFG_MAX_50MHZ_MODE_STRAP_OVERRIDE;
+  Reg &= ~SDIO2_CFG_MAX_50MHZ_MODE_STRAP_OVERRIDE;
   MmioWrite32 (BCM2712_BRCMSTB_SDIO2_CFG_BASE + SDIO2_CFG_MAX_50MHZ_MODE, Reg);
 
   // Base clock (SDC1 Caps): FMUL = 3, 200 MHz
