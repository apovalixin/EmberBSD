+#define	AICWF_MM_KEY_DEL_REQ		0x0026
+#define	AICWF_MM_KEY_DEL_CFM		0x0027
+#define	AICWF_MM_CHANNEL_SWITCH_IND	0x0044
+#define	AICWF_MM_CHANNEL_PRE_SWITCH_IND	0x0045
+#define	AICWF_MM_CHANNEL_SURVEY_IND	0x004f
