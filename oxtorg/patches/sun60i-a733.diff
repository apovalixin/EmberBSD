@@ -71,6 +71,12 @@ __KERNEL_RCSID(0, "$NetBSD: sunxi_wdt.c,v 1.6.26.1 2026/04/02 18:10:40 martin Ex
 #define	 SUNXI_WDT_KEY_FIELD		__BITS(31,16)
