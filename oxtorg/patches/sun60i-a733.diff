 }
+
+/* Read 32-bit words of the EFUSE, starting at a byte offset inside it. */
+int
+sunxi_sid_read(bus_size_t offset, uint32_t *words, u_int nwords)
+{
+	u_int n;
+
+	if (sid_softc == NULL)
+		return ENXIO;
+
+	for (n = 0; n < nwords; n++)
+		words[n] = EFUSE_READ(sid_softc, offset + 4 * n);
+	return 0;
+}
