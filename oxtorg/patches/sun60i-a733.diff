+
+# USB 3 serdes of the Type-C port (A733)
+device	sun60icombophy
+attach	sun60icombophy at fdt with sun60i_a733_combophy
+file	arch/arm/sunxi/sun60i_a733_combophy.c	sun60i_a733_combophy
+
+# A733 crypto engine (random numbers)
+device	sun60icrypto
+attach	sun60icrypto at fdt with sun60i_a733_crypto
+file	arch/arm/sunxi/sun60i_a733_crypto.c	sun60i_a733_crypto
+
 # SATA
 attach	ahcisata at fdt with sunxi_sata
 file	arch/arm/sunxi/sunxi_sata.c		sunxi_sata
