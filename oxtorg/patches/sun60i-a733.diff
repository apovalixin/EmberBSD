+	SUNXI_CCU_RESET(A733_R_RST_BUS_UART1, R_UART_BGR_REG, 17),
+	SUNXI_CCU_RESET(A733_R_RST_BUS_I2C0, R_I2C_BGR_REG, 16),
+	SUNXI_CCU_RESET(A733_R_RST_BUS_I2C1, R_I2C_BGR_REG, 17),
