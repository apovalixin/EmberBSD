+	    __BITS(26,24),		/* sel */
+	    __BIT(31),			/* enable */
+	    0),
+	SUNXI_CCU_DIV_GATE(A733_CLK_USB2_U3_UTMI, "usb2-u3-utmi",
+	    usb2_300M_parents, USB2_U3_UTMI_CLK_REG,
+	    __BITS(4,0),		/* div */
+	    __BITS(26,24),		/* sel */
+	    __BIT(31),			/* enable */
+	    0),
+	SUNXI_CCU_DIV_GATE(A733_CLK_USB2_U2_PIPE, "usb2-u2-pipe",
+	    usb2_480M_parents, USB2_U2_PIPE_CLK_REG,
+	    __BITS(4,0),		/* div */
+	    __BITS(26,24),		/* sel */
+	    __BIT(31),			/* enable */
+	    0),
