--- /dev/null
+++ sys/external/gpl2/dts/dist/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero4.dts
@@ -0,0 +1,394 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Orange Pi Zero 4.
+ *
+ * The vendor boot loader hands over with the console UART and the
+ * microSD pins already configured and the card powered.
+ */
+
+/dts-v1/;
+
+#include "sun60i-a733.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "OrangePi Zero 4";
+	compatible = "xunlong,orangepi-zero4", "allwinner,sun60i-a733";
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * The enable pins of the AIC8800 wireless module: PM1 for the
+	 * network half, PM2 for the Bluetooth half.
+	 */
+	/* Power of the Type-C data port, switched by PL8. */
+	reg_usb3_vbus: regulator-usb3-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb3-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&r_pio 0 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&r_pio 1 1 GPIO_ACTIVE_LOW>,
+			      <&r_pio 1 2 GPIO_ACTIVE_LOW>;
+	};
+
+	/* The boot loader replaces the size with what it trained. */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x40000000>;
+	};
+};
+
+/*
+ * The MAC delays both RGMII clocks and the PHY adds nothing. Measured on
+ * the board with 32 MiB of random data per 100 ps step: transmit works
+ * from 0 to 1300 ps, receive from 1200 to 2700 ps. The values below are
+ * the middles of those windows. The vendor's 1200 and 1000 ps sit on the
+ * edge of the first window and outside the second.
+ */
+&gmac0 {
+	phy-mode = "rgmii";
+	phy-handle = <&ext_rgmii_phy>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&gmac0_rgmii_pins>;
+	allwinner,tx-delay-ps = <600>;
+	allwinner,rx-delay-ps = <2000>;
+	status = "okay";
+};
+
+&mdio0 {
+	/* Motorcomm YT8531 */
+	ext_rgmii_phy: ethernet-phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <1>;
+	};
+};
+
+&mmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc0_pins>;
+	bus-width = <4>;
+	/* The chip switches the supply of the card's pins to 1.8 V. */
+	vqmmc-supply = <&reg_pf>;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	max-frequency = <150000000>;
+	broken-cd;
+	status = "okay";
+};
+
+/*
+ * The AIC8800 wireless module. Its pins run at 1.8 V; the boot loader
+ * leaves that supply on.
+ */
+&mmc1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc1_pins>;
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	non-removable;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	status = "okay";
+};
