+static int	vcmbox_rtc_gettime(todr_chip_handle_t, struct timeval *);
+static int	vcmbox_rtc_settime(todr_chip_handle_t, struct timeval *);
+static void	vcmbox_rtc_init(struct vcmbox_softc *);
 
