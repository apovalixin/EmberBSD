Origin:
cemac attached through ACPI:
the Raspberry Pi 5 GEM as the eotics-com rpi5-uefi firmware describes it
(PRP0001, "cdns,macb"), built into a kernel or as if_cemac_acpi.kmod.

--- sys/dev/acpi/files.acpi.orig
+++ sys/dev/acpi/files.acpi
@@ -321,6 +321,13 @@
 attach	genet at acpinodebus with genet_acpi
 file	dev/acpi/genet_acpi.c		genet_acpi
 
+# Cadence GEM (Raspberry Pi 5 RP1 under UEFI). The device itself is
+# defined in files.zynq, which aarch64 kernels do not include.
+device	cemac: ether, ifnet, arp, mii, bus_dma_generic
+file	dev/cadence/if_cemac.c		cemac
+attach	cemac at acpinodebus with cemac_acpi
+file	dev/acpi/cemac_acpi.c		cemac_acpi
+
 # DesignWare Ethernet Quality-of-Service controller
 attach	eqos at acpinodebus with eqos_acpi
 file	dev/acpi/eqos_acpi.c		eqos_acpi
--- sys/dev/acpi/cemac_acpi.c.orig
+++ sys/dev/acpi/cemac_acpi.c
@@ -0,0 +1,224 @@
