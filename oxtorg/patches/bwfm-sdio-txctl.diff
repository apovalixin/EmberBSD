+/*
+ * Write the frame in the bounce buffer.  The sequence number is spent
+ * only when the firmware got the frame; a failed write is terminated so
+ * that the next frame does not continue it.
+ */
+static int
+bwfm_sdio_tx_frame(struct bwfm_sdio_softc *sc, size_t len)
+{
+	int err, i;
+
+	err = bwfm_sdio_frame_read_write(sc, sc->sc_bounce_buf, len, 1);
+	sc->sc_stats.txframes++;
+	if (err == 0) {
+		sc->sc_tx_seq++;
+		return 0;
+	}
+
+	sc->sc_stats.txerrors++;
+	bwfm_sdio_write_1(sc, SD_IO_CCCR_CTL, sc->sc_sf[2]->number);
+	bwfm_sdio_write_1(sc, BWFM_SDIO_FUNC1_FRAMECTRL,
+	    BWFM_SDIO_FUNC1_FRAMECTRL_WF_TERM);
+	for (i = 0; i < 3; i++) {
+		if (bwfm_sdio_read_1(sc, BWFM_SDIO_FUNC1_WFRAMEBCHI) == 0 &&
+		    bwfm_sdio_read_1(sc, BWFM_SDIO_FUNC1_WFRAMEBCLO) == 0)
+			break;
+	}
+	return err;
 }
 
