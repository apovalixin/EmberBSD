-	return (uint8_t)(sc->sc_tx_max_seq - sc->sc_tx_seq) != 0 &&
-	    ((uint8_t)(sc->sc_tx_max_seq - sc->sc_tx_seq) & 0x80) == 0;
+	if ((uint8_t)(maxseq - sc->sc_tx_seq) > TXCOUNT_MAX) {
+		sc->sc_stats.badwindow++;
+		maxseq = sc->sc_tx_seq + 2;
+	}
+	sc->sc_tx_max_seq = maxseq;
 }
 
