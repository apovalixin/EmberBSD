+/*
+ * The firmware names, in every frame it sends, the last sequence number
+ * it will take.  The distance to it is the window: frames we may send
+ * before it speaks again.
+ */
+static unsigned
+bwfm_sdio_tx_window(struct bwfm_sdio_softc *sc)
+{
+	uint8_t space = sc->sc_tx_max_seq - sc->sc_tx_seq;
+
+	return (space & 0x80) != 0 ? 0 : space;
+}
+
+/*
+ * A window behind our own counter, or wider than the firmware has
+ * buffers for, means the two sides lost count.  Taken as it is, it
+ * closes the window for good: nothing is sent, so nothing corrects it.
+ * Linux allows two frames then, and the next header brings the truth.
+ */
+static void
+bwfm_sdio_rx_window(struct bwfm_sdio_softc *sc, uint8_t maxseq)
