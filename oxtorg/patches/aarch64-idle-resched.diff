Origin:
NetBSD core approval is required before inclusion in src. idle_loop() looks for
runnable LWPs with interrupts enabled; cpu_idle() then masks them and
waits in wfi without looking again. An interrupt taken between the two
can make an LWP runnable on this CPU, and wfi then sleeps until the next
interrupt, usually the next clock tick (10 ms at HZ=100). On a Raspberry
Pi 5 the SDIO host interrupts about 4 us after the Wi-Fi driver's thread
goes to sleep, and about a fifth of that thread's waits on cpu0 lost a
tick this way (DTrace, 24.09.2026): TCP over Wi-Fi ran at 1-1.5
Mbit/s, and 18-25 Mbit/s with this diff. cpu_idle() now checks
ci_want_resched with interrupts masked, as x86_cpu_idle_halt() does;
the check also covers the ACPI _LPI idle, cpu_acpi_lpi_idle(), which
has the same gap. NetBSD-current still has the unfixed cpu_idle()
(cpu_machdep.c 1.16, as in 11.0).

--- sys/arch/aarch64/aarch64/cpu_machdep.c.orig
+++ sys/arch/aarch64/aarch64/cpu_machdep.c
@@ -48,6 +48,7 @@
 #include <aarch64/armreg.h>
 #include <aarch64/db_machdep.h>
 #include <aarch64/frame.h>
+#include <aarch64/locore.h>
 #include <aarch64/machdep.h>
 #include <aarch64/pcb.h>
 #include <aarch64/userret.h>
@@ -381,5 +382,18 @@
 void
 cpu_idle(void)
 {
-	arm_cpu_idle();
+	struct cpu_info * const ci = curcpu();
+	const register_t daif = daif_disable(DAIF_I | DAIF_F);
+
+	/*
+	 * idle_loop() looks for work with interrupts enabled.  An
+	 * interrupt taken after that look may have made an LWP runnable
+	 * here, and wfi would then sleep until the next interrupt, often
+	 * the next clock tick.  Look again with interrupts masked: an
+	 * interrupt arriving from now on stays pending and ends wfi at
+	 * once.  x86_cpu_idle_halt() does the same.
+	 */
+	if (__predict_true(ci->ci_want_resched == 0))
+		arm_cpu_idle();
+	reg_daif_write(daif);
 }
